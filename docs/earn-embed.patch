diff --git a/app/earn/EmbedPointerBridge.tsx b/app/earn/EmbedPointerBridge.tsx
new file mode 100644
index 0000000..f457424
--- /dev/null
+++ b/app/earn/EmbedPointerBridge.tsx
@@ -0,0 +1,63 @@
+'use client'
+
+import { useEffect } from 'react'
+
+/*
+  XBorg OS draws its own 3D cursor. Inside the Stake window this page is a
+  cross-origin iframe, so the desktop never sees the pointer while it is over
+  the page. In embed mode the page hides its own cursor and reports the
+  pointer to the desktop, which keeps drawing the 3D cursor over it.
+  Only positions and button state are sent, nothing about the visitor.
+*/
+
+const INTERACTIVE = 'a, button, [role="button"], input, select, textarea, label, summary'
+const TEXT = 'p, h1, h2, h3, h4, li, span'
+
+export default function EmbedPointerBridge() {
+  useEffect(() => {
+    if (window.parent === window) return
+    const style = document.createElement('style')
+    style.textContent = '@media (hover: hover) and (pointer: fine) { *, *::before, *::after { cursor: none !important; } }'
+    document.head.appendChild(style)
+
+    let down = false
+    const send = (e: PointerEvent, kind: 'move' | 'leave') => {
+      if (e.pointerType === 'touch') return
+      const el = e.target instanceof Element ? e.target : null
+      window.parent.postMessage(
+        {
+          type: 'xborg-os:pointer',
+          kind,
+          x: e.clientX,
+          y: e.clientY,
+          down,
+          interactive: Boolean(el?.closest(INTERACTIVE)),
+          text: Boolean(el?.closest(TEXT)),
+        },
+        '*',
+      )
+    }
+    const onMove = (e: PointerEvent) => send(e, 'move')
+    const onDown = (e: PointerEvent) => {
+      down = true
+      send(e, 'move')
+    }
+    const onUp = (e: PointerEvent) => {
+      down = false
+      send(e, 'move')
+    }
+    const onLeave = (e: PointerEvent) => send(e, 'leave')
+    window.addEventListener('pointermove', onMove, { passive: true })
+    window.addEventListener('pointerdown', onDown, { passive: true })
+    window.addEventListener('pointerup', onUp, { passive: true })
+    document.documentElement.addEventListener('pointerleave', onLeave)
+    return () => {
+      style.remove()
+      window.removeEventListener('pointermove', onMove)
+      window.removeEventListener('pointerdown', onDown)
+      window.removeEventListener('pointerup', onUp)
+      document.documentElement.removeEventListener('pointerleave', onLeave)
+    }
+  }, [])
+  return null
+}
